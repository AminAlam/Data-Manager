{
  "name": "Data Manager - Google Drive Integration",
  "version": "1.0",
  "description": "Add Google Drive documents directly to your Data Manager",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "*://docs.google.com/*",
    "*://sheets.google.com/*",
    "*://slides.google.com/*",
    "*://drive.google.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://docs.google.com/*",
        "*://sheets.google.com/*",
        "*://slides.google.com/*",
        "*://drive.google.com/*"
      ],
      "js": ["contentScript.js"]
    }
  ]
} 